# Normalise line endings so the repo is identical on every platform.
* text=auto eol=lf

# Windows-only entry points must keep CRLF or cmd.exe mis-parses them.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf
*.iss text eol=crlf

# Binary
*.ico binary
*.png binary
*.zip binary
*.exe binary
