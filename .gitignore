.env
.env.*
!.env.example
# A provider key shipped inside a build for someone else to use. It lives in
# the artifact you hand over, never in this PUBLIC repository. See
# src/setup/bundled-key.mjs, and the test that keeps this rule honest.
bundled-key.json
**/bundled-key.json
credentials.dat
config.json
auth.json
*.pem
*.key

# Playwright browsers
browsers/

# OS noise
Thumbs.db
.DS_Store
desktop.ini

# Raw agent transcript from the e2e run - large and noisy. The report and the
# structured results ARE committed, as evidence.
tests/e2e/results/transcript.txt
