# Omni Agent - optional environment overrides.
#
# You do NOT need any of these. The setup wizard stores credentials encrypted
# with Windows DPAPI instead, and the agent works with no API key at all.
# These exist for technical users, CI, and containers.

# Gateway
# OMNI_AGENT_GATEWAY_URL=http://127.0.0.1:20129
# OMNIROUTE_API_KEY=
# OMNIROUTE_MANAGEMENT_KEY=

# Where the app keeps its data (default: %LOCALAPPDATA%\OmniAgent)
# OMNI_AGENT_HOME=

# Model provider keys (optional - improves speed and limits)
# ANTHROPIC_API_KEY=
# ANTHROPIC_ADMIN_KEY=
# OPENAI_API_KEY=
# OPENAI_ADMIN_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
# MOONSHOT_API_KEY=
# OPENROUTER_API_KEY=

# Search providers (optional - DuckDuckGo is used with no key)
# BRAVE_SEARCH_API_KEY=
# TAVILY_API_KEY=
# SERPER_API_KEY=

# Scraping (optional)
# FIRECRAWL_API_KEY=

# Diagnostics
# OMNI_AGENT_LOG_LEVEL=info
# OMNI_AGENT_DEBUG=1
